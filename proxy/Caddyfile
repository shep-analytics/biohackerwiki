{
	admin off
	auto_https off
	servers {
		# Only Railway's edge can reach this service; trust its X-Forwarded-* headers
		# so the real client IP / proto pass through to Outline (magic links are IP-bound).
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Forwarded-For
	}
}

(brand) {
	root * /srv/brand
	header Cache-Control "public, max-age=86400"
	file_server
}

:{$PORT:8080} {
	# www -> apex
	@www host www.biohackerwiki.com
	redir @www https://biohackerwiki.com{uri} 301

	# Logged-out visitors hitting the bare home page go to the public wiki.
	@home_anon {
		path /
		not header_regexp Cookie (^|;\s*)accessToken=
	}
	redir @home_anon /s/about-the-wiki 302

	# Static study browser (served here, never proxied to Outline)
	redir /studies /studies/ 308
	handle_path /studies/* {
		root * /srv/studies
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Brand icons
	handle /favicon.ico {
		rewrite * /favicon.ico
		import brand
	}
	@fav16 path /images/favicon-16.png
	handle @fav16 {
		rewrite * /mark-16.png
		import brand
	}
	@fav32 path /images/favicon-32.png /images/favicon-*.png
	handle @fav32 {
		rewrite * /mark-32.png
		import brand
	}
	@apple path /apple-touch-icon*.png /images/apple-touch-icon*.png
	handle @apple {
		rewrite * /mark-180.png
		import brand
	}
	@i192 path /images/icon-192.png /images/icon-maskable-192.png
	handle @i192 {
		rewrite * /mark-192.png
		import brand
	}
	@i512 path /images/icon-512.png /images/icon-maskable-512.png /images/icon-maskable-1024.png /images/icon-monochrome-*.png
	handle @i512 {
		rewrite * /mark-512.png
		import brand
	}
	handle /static/manifest.webmanifest {
		header Content-Type application/manifest+json
		rewrite * /manifest.webmanifest
		import brand
	}

	handle {
		reverse_proxy {$UPSTREAM:outline.railway.internal:3000} {
			# Preserve Host, X-Forwarded-Proto (Outline FORCE_HTTPS) and the client IP.
			header_up Host {host}
			flush_interval -1
			transport http {
				dial_timeout 10s
				}
			lb_try_duration 5s
		}
	}
}
