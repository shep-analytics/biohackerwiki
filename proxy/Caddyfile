	}
	handle /static/manifest.webmanifest {
		header Content-Type application/manifest+json
		rewrite * /manifest.webmanifest
		import brand
	}

	handle {
		reverse_proxy {$UPSTREAM:wikijs.railway.internal:3000} {
			# Preserve Host, X-Forwarded-Proto (Wiki.js) and the client IP.
			header_up Host {host}
			flush_interval -1
			transport http {
				dial_timeout 10s
				}
			lb_try_duration 5s
		}
