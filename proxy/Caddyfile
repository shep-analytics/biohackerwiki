{
	admin off
	auto_https off
	servers {
		# Only Railway's edge can reach this service; trust its X-Forwarded-* headers
		# so the real client IP / proto pass through to the wiki.
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Forwarded-For
	}
}

(brand) {
	root * /srv/brand
	header Cache-Control "public, max-age=86400"
	file_server
}

